# ========================================
# GEO Demo - .gitignore
# ========================================

# -----------------------------------------
# 🔒 敏感配置 (CRITICAL - DO NOT COMMIT!)
# -----------------------------------------
# 环境变量文件 (包含 API Key / DB 密码 / OAuth client secret 等)
# Catches .env / .env.local / .env.claude.local / .env.cloud.local /
# .env.production 等所有 dotenv 变体。example 例外单独 allow-listed。
.env
.env.*
!.env.example
!.env.*.example
# 兜底: 任意子目录下的 .env* 文件都不能入库
**/.env
**/.env.*
!**/.env.example
!**/.env.*.example

# Terraform 变量文件 (包含真实密码)
*.tfvars
!*.tfvars.example

# Terraform 状态文件 (可能包含敏感信息)
*.tfstate
*.tfstate.backup
.terraform/
.terraform.lock.hcl
*.tfplan

# Google Cloud / GCP 凭证 (service account JSON keys, ADC, OAuth 等)
**/service_account*.json
**/service-account*.json
**/gcp-key*.json
**/credentials*.json
!**/credentials.example.json
**/application_default_credentials.json
**/*-credentials.json
**/*-sa-key.json
.gcp/

# 通用密钥 / 证书 / SSH key
*.pem
*.key
!public_key.pem
!*-public.pem
id_rsa*
id_ed25519*

# Claude Code 本地配置 (permissions / local workflows) — 可能含 repo-specific tokens
.claude/settings.local.json

# 明确排除的敏感文件 (legacy explicit list, kept for clarity)
geo_collector/.env
geo_collector/.env.cloud
geo_collector/terraform/terraform.tfvars
geo_admin/terraform/terraform.tfvars
geo_admin/web/.env
geo_admin/api/.env

# -----------------------------------------
# Python
# -----------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual Environments
env/
venv/
ENV/
.venv/

# -----------------------------------------
# Node.js / JavaScript
# -----------------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.npm

# Build outputs
dist/
build/

# Vite / TypeScript
*.local
*.tsbuildinfo

# Lint / coverage caches
.eslintcache
.stylelintcache
coverage/
.coverage
htmlcov/
.nyc_output/

# Merge / patch leftovers
*.orig
*.rej

# -----------------------------------------
# IDE & Editor
# -----------------------------------------
.idea/
.vscode/
*.swp
*.swo
*~
.project
.classpath
.settings/

# -----------------------------------------
# OS Generated
# -----------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# -----------------------------------------
# Logs & Debug
# -----------------------------------------
*.log
logs/
*.pid
*.seed

# -----------------------------------------
# Docker
# -----------------------------------------
docker-compose.override.yml

# -----------------------------------------
# Database
# -----------------------------------------
*.sqlite
*.db

# -----------------------------------------
# Miscellaneous
# -----------------------------------------
*.bak
*.tmp
*.temp
.cache/
.gstack/
