# Database (shared Cloud SQL with geo_saas)
DATABASE_URL=postgresql://user:password@localhost:5432/geo_db

# Google Cloud
GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=us-central1
GCP_REGION_GLOBAL=global

# CORS
ALLOWED_ORIGINS=http://localhost:5173

# Application
ENVIRONMENT=development
LOG_LEVEL=INFO

# NOTE: Gemini model IDs are read from geo_global_settings table:
#   agent_pro_model_id   → Analyze/Action agents
#   agent_flash_model_id → Supervisor/Chat
# See migrations/009_add_agent_tables.sql for seed values.
