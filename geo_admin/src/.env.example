# ============================================================================
# GEO Admin API — Environment Variables
# ============================================================================
# Copy this file to .env and fill in your actual values:
#   cp .env.example .env
# ============================================================================

# --- Database ---
DATABASE_URL=postgresql+asyncpg://your-user:your-password@localhost:5432/your-db-name

# --- Google Cloud ---
GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=us-central1

# --- CORS (comma-separated, no spaces) ---
ALLOWED_ORIGINS=http://localhost:5173

# --- Vertex AI (Gemini for Brainstorming) ---
GEMINI_MODEL_ID=gemini-3-flash-preview

# --- Cloud Run Job Invocation ---
ADMIN_API_URL=https://your-admin-api.run.app
INVOKER_SERVICE_ACCOUNT=your-compute@developer.gserviceaccount.com
