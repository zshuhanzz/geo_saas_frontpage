# GEO Admin Web - 本地开发环境变量
# 复制此文件为 .env 并填入实际值

# Google OAuth Client ID (从 GCP Console 获取)
VITE_GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID

# Absolute SaaS Web origin used by guided Workspace deletion links.
# Local example: http://localhost:6174
# Production example: the deployed geo-saas-web HTTPS origin.
VITE_SAAS_WEB_URL=YOUR_SAAS_WEB_ORIGIN
