# ========================================
# GEO Demo - .gitignore
# ========================================

# -----------------------------------------
# 🔒 敏感配置 (CRITICAL - DO NOT COMMIT!)
# -----------------------------------------
# 环境变量文件 (包含 API Key, 密码等)
.env
.env.*
!.env.example
!.env.*.example

# Terraform 变量文件 (包含真实密码)
*.tfvars
!*.tfvars.example

# Terraform 状态文件 (可能包含敏感信息)
*.tfstate
*.tfstate.backup
.terraform/
.terraform.lock.hcl
*.tfplan

# 明确排除的敏感文件
geo_collector/.env
geo_collector/.env.cloud
geo_collector/terraform/terraform.tfvars
geo_admin/terraform/terraform.tfvars
geo_admin/web/.env
geo_admin/api/.env

# -----------------------------------------
# Python
# -----------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual Environments
env/
venv/
ENV/
.venv/

# -----------------------------------------
# Node.js / JavaScript
# -----------------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.npm

# Build outputs
dist/
build/

# -----------------------------------------
# IDE & Editor
# -----------------------------------------
.idea/
.vscode/
*.swp
*.swo
*~
.project
.classpath
.settings/

# -----------------------------------------
# OS Generated
# -----------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# -----------------------------------------
# Logs & Debug
# -----------------------------------------
*.log
logs/
*.pid
*.seed

# -----------------------------------------
# Docker
# -----------------------------------------
docker-compose.override.yml

# -----------------------------------------
# Database
# -----------------------------------------
*.sqlite
*.db

# -----------------------------------------
# Miscellaneous
# -----------------------------------------
*.bak
*.tmp
*.temp
.cache/