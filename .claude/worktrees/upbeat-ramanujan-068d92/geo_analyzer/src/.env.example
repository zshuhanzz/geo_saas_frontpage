# GEO Analyzer - Environment Variables Template
# Copy this file to .env and update with real values

# ==============================================
# Database Connection (本地开发使用 TCP)
# ==============================================
DB_HOST=localhost
DB_PORT=5432
DB_USER=your-db-user
DB_PASS=your-db-password
DB_NAME=your-db-name

# ==============================================
# Cloud SQL Connection (Cloud Run 使用 Unix Socket)
# 本地开发时留空，代码会使用上面的 DB_HOST:DB_PORT
# Cloud Run 部署时由 Terraform 注入，不读此文件
# ==============================================
CLOUD_SQL_CONNECTION_NAME=

# ==============================================
# GCP Settings
# ==============================================
GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=us-central1
