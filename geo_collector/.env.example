# Database Configuration (Cloud SQL / Local PostgreSQL)
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/geo_db

# Cloro API Configuration
CLORO_API_KEY=your_cloro_api_key_here
CLORO_BASE_URL=https://api.cloro.dev

# Google Cloud Pub/Sub Configuration
PUBSUB_PROJECT_ID=your_gcp_project_id
PUBSUB_CALLBACKS_TOPIC=geo-cloro-callbacks
PUBSUB_TASKS_TOPIC=geo-tasks-pending

# Webhook Configuration
# This is the public URL where Cloro will send callbacks to your Cloud Run Service
WEBHOOK_PUBLIC_URL=https://your-cloud-run-service-url.run.app
WEBHOOK_SECRET=your_webhook_signature_secret

# Application Settings
ENVIRONMENT=development
LOG_LEVEL=INFO

# Vertex AI (Gemini) Configuration
GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=us-central1
GCP_REGION_GLOBAL=global
GEMINI_MODEL_ID=gemini-3-flash-preview